{
  "openapi": "3.1.0",
  "info": {
    "title": "Live Seminar Transcriber",
    "summary": "Live seminar transcription with an LLM assistant over the running transcript.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "description": "Report that the process is alive, and which optional capabilities are installed.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Api Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/session": {
      "get": {
        "tags": [
          "session"
        ],
        "summary": "Get Session",
        "description": "The current session and pipeline state.",
        "operationId": "get_session_api_session_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/session/start": {
      "post": {
        "tags": [
          "session"
        ],
        "summary": "Start Session",
        "description": "Begin capture and transcription.",
        "operationId": "start_session_api_session_start_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartSessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/session/stop": {
      "post": {
        "tags": [
          "session"
        ],
        "summary": "Stop Session",
        "description": "End the session and return its final statistics.",
        "operationId": "stop_session_api_session_stop_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionStoppedResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/audio/devices": {
      "get": {
        "tags": [
          "session"
        ],
        "summary": "Get Devices",
        "description": "Microphones and loopback devices in one merged list, each tagged with its type.\n\nUnavailability is reported rather than hidden: an empty list with no explanation looks like a\nbroken feature, whereas one naming the install command is actionable.",
        "operationId": "get_devices_api_audio_devices_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/audio/device": {
      "post": {
        "tags": [
          "session"
        ],
        "summary": "Select Device",
        "description": "Choose the capture source. Takes effect when the next session starts.",
        "operationId": "select_device_api_audio_device_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectDeviceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Select Device Api Audio Device Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/asr/models": {
      "get": {
        "tags": [
          "session"
        ],
        "summary": "Get Asr Models",
        "description": "Every backend with the information needed to choose between them (FE \u00a77.2).",
        "operationId": "get_asr_models_api_asr_models_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AsrModelsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/asr/load": {
      "post": {
        "tags": [
          "session"
        ],
        "summary": "Load Model",
        "description": "Load a model. Progress arrives over the WebSocket as ``asr.progress``.",
        "operationId": "load_model_api_asr_load_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoadModelRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Load Model Api Asr Load Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/asr/unload": {
      "post": {
        "tags": [
          "session"
        ],
        "summary": "Unload Model",
        "description": "Free the model and its device memory \u2014 relevant when a local LLM shares the GPU.",
        "operationId": "unload_model_api_asr_unload_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Unload Model Api Asr Unload Post"
                }
              }
            }
          }
        }
      }
    },
    "/api/asr/prompt": {
      "post": {
        "tags": [
          "session"
        ],
        "summary": "Set Session Prompt",
        "description": "Set the biasing prompt. Live: it applies to the next inference pass.",
        "operationId": "set_session_prompt_api_asr_prompt_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessionPromptRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Set Session Prompt Api Asr Prompt Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/transcript/since/{segment_id}": {
      "get": {
        "tags": [
          "transcript"
        ],
        "summary": "Since",
        "description": "Everything after ``segment_id``. Ordered by id, which makes the replay idempotent.",
        "operationId": "since_api_transcript_since__segment_id__get",
        "parameters": [
          {
            "name": "segment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Segment Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 5000,
              "minimum": 1,
              "default": 500,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SegmentListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/transcript/range": {
      "get": {
        "tags": [
          "transcript"
        ],
        "summary": "Time Range",
        "description": "Everything overlapping a time range \u2014 what \"summarise the last ten minutes\" reads.",
        "operationId": "time_range_api_transcript_range_get",
        "parameters": [
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "minimum": 0.0,
              "default": 0.0,
              "title": "Start"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "minimum": 0.0,
              "title": "End"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SegmentListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/transcript/search": {
      "get": {
        "tags": [
          "transcript"
        ],
        "summary": "Search",
        "description": "Full-text search. A query that FTS5 cannot parse returns nothing rather than an error.",
        "operationId": "search_api_transcript_search_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 500,
              "default": "",
              "title": "Q"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/transcript/summaries": {
      "get": {
        "tags": [
          "transcript"
        ],
        "summary": "Summaries",
        "description": "The running outline of the talk.",
        "operationId": "summaries_api_transcript_summaries_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SummariesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/transcript/glossary": {
      "get": {
        "tags": [
          "transcript"
        ],
        "summary": "Glossary",
        "description": "The session glossary, in order of first appearance.",
        "operationId": "glossary_api_transcript_glossary_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GlossaryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/transcript/export": {
      "get": {
        "tags": [
          "transcript"
        ],
        "summary": "Export",
        "description": "Download the transcript in one of the five formats.",
        "operationId": "export_api_transcript_export_get",
        "parameters": [
          {
            "name": "fmt",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "markdown",
              "title": "Fmt"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/config": {
      "get": {
        "tags": [
          "config"
        ],
        "summary": "Get Config",
        "description": "The full resolved configuration.",
        "operationId": "get_config_api_config_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigResponse"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "config"
        ],
        "summary": "Patch Config",
        "description": "Apply dotted-path changes and report what applying them costs.\n\nThe hot-swap class comes back with the response so the frontend can warn *before* the user\ncommits to something that will interrupt transcription (BE \u00a713.3).",
        "operationId": "patch_config_api_config_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfigPatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigPatchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/config/preset": {
      "post": {
        "tags": [
          "config"
        ],
        "summary": "Apply Preset",
        "description": "Apply a named profile \u2014 Accuracy, Balanced, or Low resource.",
        "operationId": "apply_preset_api_config_preset_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PresetRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigPatchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/config/save": {
      "post": {
        "tags": [
          "config"
        ],
        "summary": "Save Config",
        "description": "Persist runtime changes to the user config file. Credentials are never written.",
        "operationId": "save_config_api_config_save_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Save Config Api Config Save Post"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AsrModelsResponse": {
        "properties": {
          "backends": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Backends"
          },
          "current": {
            "additionalProperties": true,
            "type": "object",
            "title": "Current"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "backends",
          "current"
        ],
        "title": "AsrModelsResponse",
        "description": "Every backend, including ones that cannot run here, with the reason attached."
      },
      "ConfigPatchRequest": {
        "properties": {
          "changes": {
            "additionalProperties": true,
            "type": "object",
            "title": "Changes"
          },
          "layer": {
            "type": "string",
            "enum": [
              "runtime",
              "session",
              "user"
            ],
            "title": "Layer",
            "default": "runtime"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "changes"
        ],
        "title": "ConfigPatchRequest",
        "description": "Dotted-path changes, applied atomically."
      },
      "ConfigPatchResponse": {
        "properties": {
          "applied": {
            "type": "boolean",
            "title": "Applied"
          },
          "hot_swap": {
            "type": "string",
            "enum": [
              "live",
              "restart-stage",
              "restart-session"
            ],
            "title": "Hot Swap"
          },
          "consequence": {
            "type": "string",
            "title": "Consequence"
          },
          "config": {
            "additionalProperties": true,
            "type": "object",
            "title": "Config"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "applied",
          "hot_swap",
          "consequence",
          "config"
        ],
        "title": "ConfigPatchResponse",
        "description": "What applying the change costs the running session (BE \u00a713.3)."
      },
      "ConfigResponse": {
        "properties": {
          "config": {
            "additionalProperties": true,
            "type": "object",
            "title": "Config"
          },
          "presets": {
            "items": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "type": "array",
            "title": "Presets"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "config",
          "presets"
        ],
        "title": "ConfigResponse",
        "description": "The full resolved configuration, plus what each area costs to change."
      },
      "DeviceListResponse": {
        "properties": {
          "devices": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Devices"
          },
          "device_support": {
            "type": "boolean",
            "title": "Device Support"
          },
          "note": {
            "type": "string",
            "title": "Note",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "devices",
          "device_support"
        ],
        "title": "DeviceListResponse",
        "description": "Microphones and loopback devices in one merged list, each tagged with its type."
      },
      "GlossaryResponse": {
        "properties": {
          "terms": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Terms"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "terms"
        ],
        "title": "GlossaryResponse",
        "description": "The session glossary."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoadModelRequest": {
        "properties": {
          "backend": {
            "type": "string",
            "title": "Backend"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "device": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "auto",
                  "cpu",
                  "cuda"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Device"
          },
          "precision": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "int8",
                  "float16",
                  "float32"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Precision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "backend",
          "model"
        ],
        "title": "LoadModelRequest",
        "description": "Load a specific model."
      },
      "PresetRequest": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "PresetRequest",
        "description": "Apply a named profile."
      },
      "SearchResponse": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "segments": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Segments"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "query",
          "segments"
        ],
        "title": "SearchResponse",
        "description": "Full-text search results."
      },
      "SegmentListResponse": {
        "properties": {
          "segments": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Segments"
          },
          "last_id": {
            "type": "integer",
            "title": "Last Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "segments",
          "last_id"
        ],
        "title": "SegmentListResponse",
        "description": "A page of committed segments."
      },
      "SelectDeviceRequest": {
        "properties": {
          "device_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Id"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "microphone",
              "loopback",
              "file"
            ],
            "title": "Source Type",
            "default": "microphone"
          },
          "file_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Path"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "SelectDeviceRequest",
        "description": "Choose a capture source."
      },
      "SessionPromptRequest": {
        "properties": {
          "prompt": {
            "type": "string",
            "title": "Prompt",
            "default": ""
          },
          "use_session_prompt": {
            "type": "boolean",
            "title": "Use Session Prompt",
            "default": true
          },
          "use_rolling_prompt": {

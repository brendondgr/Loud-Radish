#!/usr/bin/env bash
# Loud Radish, from a terminal (D-056).
#
#     radish              start the server and the tray icon in the background
#     radish stop         stop them
#     radish status       what is running, and what it is doing
#
# Installed as a symlink in ~/.local/bin, so editing this file changes the command immediately:
#
#     ln -sf "$PWD/scripts/radish" ~/.local/bin/radish
#
# **Two things here are not arbitrary and should not be tidied away.**
#
# The companion is started with `uv run --no-sync`. A plain `uv run` synchronises the environment
# against the lockfile, and the lockfile says PyPI — so it replaces the ROCm build of CTranslate2
# with the CPU/CUDA one and the *server's* next model load fails. `app.py` repairs that on its own
# launch, which is why the server is started first and without the flag. Since D-064 the companion
# repairs it too, as does every script — but a sync that is then undone is still a reinstall on
# every start, so the flag stays.
#
# The `pgrep` patterns are anchored to the resolved interpreter path. A looser pattern such as
# `app.py` matches the shell that is running this script, so `radish stop` would kill itself
# mid-command — which is exactly what happened, repeatedly, while this was being built.

set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
REPO="$(cd "$(dirname "$SELF")/.." && pwd)"
PYTHON="$REPO/.venv/bin/python3"
PORT="${API_PORT:-8395}"
HOST="${API_HOST:-127.0.0.1}"
BASE="http://$HOST:$PORT"
LOGS="$REPO/logs"

SERVER_MATCH="$PYTHON app.py"
COMPANION_MATCH="$PYTHON -m app.companion.main"

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
dim() { printf '\033[2m%s\033[0m\n' "$*"; }
warn() { printf '\033[33m%s\033[0m\n' "$*" >&2; }

# The `-x`-like anchoring matters: see the note about killing our own shell.
pids_for() { pgrep -f -- "^$1" 2>/dev/null | grep -v "^$$\$" || true; }
server_pids() { pids_for "$SERVER_MATCH"; }
companion_pids() { pids_for "$COMPANION_MATCH"; }

answers() { curl -fsS -m 2 "$BASE/api/health" >/dev/null 2>&1; }

require_venv() {
    if [[ ! -x "$PYTHON" ]]; then
        warn "No virtual environment at $PYTHON."
        warn "Run 'uv sync' in $REPO first."
        exit 1
    fi
}

start_one() {
    # $1 label, $2 working directory, $3 log file, rest: the command.
    local label="$1" cwd="$2" log="$3"
    shift 3
    mkdir -p "$LOGS"
    # **`--fork` is load-bearing, and so is redirecting all three descriptors.**
    #
    # `( cd … && setsid nohup cmd >log 2>&1 & )` looks equivalent and is not. The subshell ends up
    # in `do_wait` on its child, and — because a background job inherits this script's descriptors
    # — it holds the terminal's stdout open for as long as the server runs. `radish start | tail`
    # then never finishes, and neither does anything else piping from it. Watched happening:
    # two `bash radish start` processes still alive minutes later, both with fd 1 on the pipe.
    #
    # `setsid --fork` always forks and returns immediately; the redirections apply to the child,
    # and `</dev/null` stops it ever reading from a terminal that may since have closed.
    setsid --fork env -C "$cwd" "$@" >>"$log" 2>&1 </dev/null
    dim "  $label → $log"
}

cmd_start() {
    require_venv
    local running=0

    if [[ -n "$(server_pids)" ]]; then
        dim "  the server is already running"
        running=1
    else
        # No `--no-sync`: `app.py` puts the ROCm wheel back that `uv` may have just replaced.
        start_one "server" "$REPO" "$LOGS/server.log" uv run app.py --port "$PORT" --host "$HOST"
    fi

    if [[ $running -eq 0 ]]; then
        printf '  waiting for %s' "$BASE"
        for _ in $(seq 1 60); do
            if answers; then printf ' ok\n'; break; fi
            printf '.'
            sleep 0.5
        done
        if ! answers; then
            printf '\n'
            warn "The server did not answer within 30 seconds. Last few lines:"
            tail -n 15 "$LOGS/server.log" >&2 || true
            exit 1
        fi
    fi

    if [[ -n "$(companion_pids)" ]]; then
        dim "  the tray icon is already running"
    else
        start_one "tray icon" "$REPO/web/backend" "$LOGS/companion.log" \
            env "LOUD_RADISH_ROOT=$REPO" uv run --no-sync python -m app.companion.main
    fi

    bold "Loud Radish is running — $BASE"
    dim "  radish status   what it is doing"
    dim "  radish stop     stop it"
}

stop_pids() {
    # $1 label, rest: pids. TERM, then KILL only for what is left.
    local label="$1"
    shift
    [[ $# -eq 0 ]] && return 0
    kill "$@" 2>/dev/null || true
    for _ in $(seq 1 20); do
        local alive=()
        for pid in "$@"; do kill -0 "$pid" 2>/dev/null && alive+=("$pid"); done
        [[ ${#alive[@]} -eq 0 ]] && { dim "  stopped $label"; return 0; }
        sleep 0.25
    done
    for pid in "$@"; do kill -9 "$pid" 2>/dev/null || true; done
    dim "  stopped $label (forced)"
}

cmd_stop() {
    local server companion
    # Read the pids into arrays before killing anything: the companion polls the server, and
    # stopping the server first makes its pid harder to find a moment later.
    mapfile -t companion < <(companion_pids)
    mapfile -t server < <(server_pids)

    if [[ ${#companion[@]} -eq 0 && ${#server[@]} -eq 0 ]]; then
        dim "  nothing was running"
        return 0
    fi
    stop_pids "the tray icon" "${companion[@]}"
    stop_pids "the server" "${server[@]}"
    bold "Loud Radish stopped."
}

cmd_status() {
    local server companion
    mapfile -t server < <(server_pids)
    mapfile -t companion < <(companion_pids)

    bold "Loud Radish"
    if [[ ${#server[@]} -gt 0 ]]; then
        printf '  server      running (pid %s) on %s\n' "${server[0]}" "$BASE"
    else
        printf '  server      not running\n'
    fi
    if [[ ${#companion[@]} -gt 0 ]]; then
        printf '  tray icon   running (pid %s)\n' "${companion[0]}"
    else
        printf '  tray icon   not running\n'
    fi

    [[ ${#server[@]} -eq 0 ]] && return 0
    if ! answers; then
        warn "  the process is up but the server is not answering yet"
        return 0
    fi

    # What it is *doing* matters as much as whether it is up.
    "$PYTHON" "$REPO/utils/loud_radish_ctl.py" --host "$HOST" --port "$PORT" status 2>/dev/null |
        sed 's/^/  /' || true
    curl -fsS -m 2 "$BASE/api/dictation" 2>/dev/null |
        "$PYTHON" -c 'import json,sys
state = json.load(sys.stdin)
if state.get("busy") or state.get("state") not in ("idle", None):
    print(f"  dictation   {state[\"state\"]}")' 2>/dev/null || true
}

cmd_logs() {
    local which="${1:-server}"
    case "$which" in
        server | companion) shift || true ;;
        -f | --follow) which="server" ;;
        *) which="server" ;;
    esac
    local file="$LOGS/$which.log"
    [[ -f "$file" ]] || { warn "No log yet at $file"; exit 1; }
    if [[ "${1:-}" == "-f" || "${1:-}" == "--follow" ]]; then
        tail -f "$file"
    else
        tail -n 60 "$file"
    fi
}

usage() {
    cat <<EOF
$(bold "radish — Loud Radish from a terminal")

  radish                    start the server and the tray icon in the background
  radish start              the same
  radish stop               stop both
  radish restart            stop, then start
  radish status             what is running, and what it is doing
  radish logs [server|companion] [-f]

  radish open               open the interface in a browser
  radish settings           open the native settings window
  radish dictate            start a dictation, or finish the one running

  radish install            start with the desktop session (systemd user unit)
  radish uninstall          stop doing that

$(dim "  'radish stop' stops the application. To stop a recording, press Meta+Alt+X")
$(dim "  or run 'radish -- stop'. Anything after -- goes to loud_radish_ctl.py.")

  Serving on $BASE — set API_PORT or API_HOST to change it.
EOF
}

main() {
    local command="${1:-start}"
    [[ $# -gt 0 ]] && shift

    case "$command" in
        start) cmd_start ;;
        stop) cmd_stop ;;
        restart)
            cmd_stop
            cmd_start
            ;;
        status) cmd_status ;;
        logs) cmd_logs "$@" ;;
        open)
            require_venv
            xdg-open "$BASE" >/dev/null 2>&1 &
            dim "  opened $BASE"
            ;;
        settings)
            require_venv
            start_one "settings window" "$REPO/web/backend" "$LOGS/settings.log" \
                "$PYTHON" -m app.companion.settings --host "$HOST" --port "$PORT"
            ;;
        install) exec uv run --directory "$REPO" python scripts/install_autostart.py "$@" ;;
        uninstall) exec uv run --directory "$REPO" python scripts/install_autostart.py --uninstall ;;
        help | --help | -h) usage ;;
        --)
            require_venv
            exec "$PYTHON" "$REPO/utils/loud_radish_ctl.py" --host "$HOST" --port "$PORT" "$@"
            ;;
        # The session commands, named explicitly rather than passed through by default.
        #
        # A blanket fallthrough sends a typo to `loud_radish_ctl.py`, which answers with its own
        # usage — and *its* `start` and `stop` mean start and stop a **recording**, not the
        # application. Someone who mistyped `radish restart` would be told to "choose from start,
        # stop, …", which is the most misleading help this could possibly give.
        toggle | arm | dictate)
            require_venv
            exec "$PYTHON" "$REPO/utils/loud_radish_ctl.py" --host "$HOST" --port "$PORT" \
                "$command" "$@"
            ;;
        *)
            warn "radish: unknown command '$command'"
            echo >&2
            usage >&2
            exit 2
            ;;
    esac
}

main "$@"

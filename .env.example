# Copy to .env and fill in. .env is gitignored and must never be committed.
# Every environment variable the project uses must be listed here with a safe
# placeholder, added in the same change that introduces it.

# --- Application ---
APP_ENV=development
LOG_LEVEL=info

# --- Backend API ---
API_HOST=127.0.0.1
API_PORT=8000

# --- Frontend ---
# Base URL the browser client uses to reach the API.
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# --- Storage ---
# Where uploaded audio and generated transcripts are written.
DATA_DIR=./data
LOG_DIR=./logs

# --- Transcription engine ---
# Engine not yet selected. If a hosted API is chosen, its credential goes here
# and NEVER in source control.
# TRANSCRIPTION_ENGINE=
# TRANSCRIPTION_API_KEY=

# --- Persistence ---
# Persistence layer not yet selected.
# DATABASE_URL=

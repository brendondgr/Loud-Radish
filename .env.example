# Copy to .env and fill in. .env is gitignored and must never be committed.
# Every environment variable the project uses must be listed here with a safe
# placeholder, added in the same change that introduces it.

# --- Application ---
APP_ENV=development
LOG_LEVEL=info

# --- Backend server ---
# The application binds to loopback. It is single-user and unauthenticated;
# exposing it on a network interface would publish an unauthenticated
# transcript of a private room.
API_HOST=127.0.0.1
API_PORT=8395

# --- Configuration ---
# Where the user configuration file is read and written. Defaults to
# ./data/loud-radish-config.json when unset. Credentials are NEVER written here.
# LOUD_RADISH_CONFIG_PATH=./data/loud-radish-config.json
#
# Renamed in D-038. The pre-rename names are still read so an existing install keeps
# working, and using one logs a warning: TRANSCRIBER_CONFIG_PATH, TRANSCRIBER_ROOT,
# TRANSCRIBER_NO_GPU_REPAIR. Do not set them in new installs.
#
# Where the repository lives, for the tray companion's shortcut commands. Defaults to
# the working directory.
# LOUD_RADISH_ROOT=.
#
# Set to 1 to stop the launcher reinstalling the kept ROCm wheel.
# LOUD_RADISH_NO_GPU_REPAIR=1

# --- Storage ---
DATA_DIR=./data
LOG_DIR=./logs
# Where session transcripts are written.
SESSION_DIR=./data/sessions

# --- Speech recognition ---
# backend: mock | file | faster-whisper
#   mock          — scripted output, for deterministic testing of the commit policy
#   faster-whisper — installed by default (D-023); weights download on first load
ASR_BACKEND=mock
ASR_MODEL=small
# device: auto | cpu | cuda
ASR_DEVICE=auto

# --- Language model ---
# mode: local | api
LLM_MODE=local
# Local OpenAI-compatible server. Ollama :11434, LM Studio :1234, llama.cpp :8080.
LLM_LOCAL_ENDPOINT=http://localhost:11434/v1
LLM_LOCAL_MODEL=
# Hosted provider, used when LLM_MODE=api.
LLM_API_PROVIDER=anthropic
LLM_API_MODEL=

# --- Credentials ---
# API keys are read from the OS credential store when the optional 'credentials'
# dependency group is installed. These environment variables are the fallback.
# Never commit a real value; never log one; never send one to the frontend.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
